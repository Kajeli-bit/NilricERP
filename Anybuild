# Custom Anybuild definition for NilricERP (Laravel on Wasmer Edge).
#
# This file replaces the auto-generated one. It adds build_post steps that
# remove node_modules and prune Composer dev dependencies after the build,
# so the exported runtime image stays small and the depot builder does not
# run out of memory while exporting it.

load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    node_package_manager = "npm",
    node_build_command = "npm run build",
    node_version = "24",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd-wasmer",
    php_version = "8.3.29",
    php_public_dir = "public",
    commands = {
        # Keep the deploy hook to one Artisan command. It runs migrations and
        # applies the idempotent organization seed without shell chaining.
        "after_deploy": "php artisan nilric:prepare-deploy --no-interaction",
    },
)

build = laravel_build(config)

laravel_serve(
    config,
    build,
    name = "nilricerp",
    # Strip everything the runtime does not need after assets are compiled:
    # - node_modules (Vite output in public/build is already produced)
    # - Composer dev dependencies (phpunit, pest, pint, boost, ...)
    # The --no-dev prune must be followed by package:discover: the earlier
    # dev install generated bootstrap/cache/packages.php listing dev-only
    # providers (Laravel\Boost, Pail, Collision, ...). With --no-scripts
    # that manifest is never regenerated, so at runtime Laravel tries to
    # load classes that no longer exist ("Class ... not found").
    # The stale manifest files MUST be deleted before running artisan:
    # artisan boots the app first, which reads the old manifest and fails
    # with the same "Class ... not found" error before package:discover
    # can ever rewrite it (chicken-and-egg). Deleting them forces Laravel
    # to rebuild packages.php/services.php from the production-only tree.
    build_post = [
        run("rm -rf node_modules", group = "build"),
        run(
            "composer install --no-dev --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction",
            group = "build",
        ),
        run(
            "rm -f bootstrap/cache/packages.php bootstrap/cache/services.php bootstrap/cache/config.php",
            group = "build",
        ),
        # Force a fast-failing local DB address: Wasmer injects the remote
        # MySQL host at build time, and connecting to it from the build
        # machine hangs until the 300s step timeout. artisan commands here
        # (package:discover) never write to the database, so a connection
        # refusal is instant and harmless with the fail-safe probe above.
        run(
            "DB_HOST=127.0.0.1 DB_PORT=3306 DB_DATABASE=laravel DB_USERNAME=root DB_PASSWORD= php artisan package:discover --ansi",
            group = "build",
        ),
    ],
)
